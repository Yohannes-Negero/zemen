# Zemen reads these from the environment. Examples for common shells:
#   PowerShell:  $env:ZEMEN_OPENSEARCH_URL = "http://localhost:9200"
#   bash:        export ZEMEN_OPENSEARCH_URL=http://localhost:9200

ZEMEN_OPENSEARCH_URL=http://localhost:9200
ZEMEN_OPENSEARCH_USERNAME=admin
ZEMEN_OPENSEARCH_PASSWORD=changeme
# ZEMEN_OPENSEARCH_API_KEY=
# true only for self-signed https certificates:
ZEMEN_OPENSEARCH_INSECURE_SKIP_VERIFY=false

# Where editable templates live (calendar_custom.json, replay_cases/, ...)
ZEMEN_DATA_DIR=zemen-data
ZEMEN_INDEX_PREFIX=zemen
ZEMEN_TZ_OFFSET_HOURS=3

# Scheduler (zemen run)
ZEMEN_SYNC_INTERVAL=10m
ZEMEN_REPLAY_INTERVAL=24h

# Dashboard (zemen serve / zemen run). Keep on localhost unless you set a token.
ZEMEN_UI_ADDR=127.0.0.1:8080
# ZEMEN_UI_TOKEN=choose-a-long-random-string

# Forecast notifications (Slack-style incoming webhook or any JSON endpoint)
# ZEMEN_WEBHOOK_URL=
ZEMEN_FORECAST_LEAD_DAYS=7
ZEMEN_FORECAST_HORIZON_DAYS=60

# Replay Court
ZEMEN_REPLAY_WAIT=3m
ZEMEN_REPLAY_POLL_INTERVAL=10s
# true = also ask Alerting to run the detector's workflow right after replay (unverified API; off by default)
ZEMEN_REPLAY_TRIGGER=false

# Tuning
ZEMEN_LABEL_WINDOW_DAYS=90
ZEMEN_MIN_CONFIDENCE=0.30
ZEMEN_DEFAULT_SILENCE=168h
ZEMEN_FINDINGS_MAX=200000
ZEMEN_DEBT_VERIFY_DAYS=30
ZEMEN_DEBT_WEIGHT_AGE=0.40
ZEMEN_DEBT_WEIGHT_FP=0.30
ZEMEN_DEBT_WEIGHT_COVERAGE=0.30
